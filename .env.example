# Supabase Configuration
# Obtenha estas credenciais no painel do Supabase:
# https://supabase.com/dashboard → Settings → API
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_KEY_HERE

# IMPORTANTE: NUNCA coloque a service_role key em variáveis VITE_ ou no frontend.
# A service_role key deve ser usada APENAS em funções serverless (Edge Functions).
